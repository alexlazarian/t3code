# Optional local build configuration. `cp .env.example .env` and uncomment what you need.
# Do not add server-side secrets to this file.

# Optional: signed macOS builds. The provisioning profile decides which in-app browser
# passkey entitlements (Touch ID keychain group, browser passkeys) the app is signed with.
# T3CODE_APPLE_TEAM_ID=ABC1234567
# T3CODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/t3code.provisionprofile
